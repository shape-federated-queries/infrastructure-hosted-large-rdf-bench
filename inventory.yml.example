# =============================================================================
# Copy this file to `inventory.yml` and fill in the machine addresses.
# `inventory.yml` is git-ignored so your node/user/key never get committed.
#
# Each host is a machine; its name is what `host:` refers to in sparql-endpoints.yml.
# Add more hosts here to spread the endpoints over several machines.
# =============================================================================

all:
  vars:
    ansible_user: ubuntu
    ansible_python_interpreter: /usr/bin/python3
  children:
    qlever:
      hosts:
        node-1: { ansible_host: 192.0.2.10 }
